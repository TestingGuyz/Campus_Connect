{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Represents a student in the CampusConnect application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The student's full name."
        },
        "email": {
          "type": "string",
          "description": "The student's email address.",
          "format": "email"
        },
        "password": {
          "type": "string",
          "description": "The student's password (hashed or otherwise secured)."
        }
      },
      "required": [
        "name"
      ]
    },
    "Class": {
      "title": "Class",
      "description": "Represents a class (e.g., Grade 10) in the school.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the class (e.g., 'Grade 10')."
        }
      },
      "required": [
        "name"
      ]
    },
    "Section": {
      "title": "Section",
      "description": "Represents a section within a class (e.g., A, B, C).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the section (e.g., 'A')."
        }
      },
      "required": [
        "name"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Represents an administrator user in the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The admin's full name."
        },
        "email": {
          "type": "string",
          "description": "The admin's email address.",
          "format": "email"
        },
        "password": {
          "type": "string",
          "description": "The admin's password."
        }
      },
      "required": [
        "name",
        "email"
      ]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Represents a teacher user in the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The teacher's full name."
        },
        "email": {
          "type": "string",
          "description": "The teacher's email address.",
          "format": "email"
        },
        "password": {
          "type": "string",
          "description": "The teacher's password."
        },
        "classIds": {
          "type": "array",
          "description": "References to Classes taught by the teacher.",
          "items": {
            "type": "string"
          }
        },
        "sectionIds": {
          "type": "array",
          "description": "References to Sections taught by the teacher.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "email"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "collections": {
      "classes": {
        "schema": {
          "$ref": "#/entities/Class"
        },
        "description": "Top-level collection for all classes in the school.",
        "collections": {
          "sections": {
            "schema": {
              "$ref": "#/entities/Section"
            },
            "description": "Sub-collection for sections within a class.",
            "collections": {
              "students": {
                "schema": {
                  "$ref": "#/entities/Student"
                },
                "description": "Sub-collection for students within a specific class and section."
              }
            }
          }
        }
      },
      "admins": {
        "schema": {
          "$ref": "#/entities/Admin"
        },
        "description": "Collection for administrator accounts."
      },
      "teachers": {
        "schema": {
          "$ref": "#/entities/Teacher"
        },
        "description": "Collection for teacher accounts."
      }
    },
    "initialData": [
