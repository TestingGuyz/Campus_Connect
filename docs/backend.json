{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Represents a student in the CampusConnect application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The student's full name."
        },
        "email": {
          "type": "string",
          "description": "The student's email address.",
          "format": "email"
        },
        "password": {
          "type": "string",
          "description": "The student's password (hashed or otherwise secured)."
        }
      },
      "required": [
        "name"
      ]
    },
    "Class": {
      "title": "Class",
      "description": "Represents a class (e.g., Grade 10) in the school.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the class (e.g., 'Grade 10')."
        }
      },
      "required": [
        "name"
      ]
    },
    "Section": {
      "title": "Section",
      "description": "Represents a section within a class (e.g., A, B, C).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the section (e.g., 'A')."
        }
      },
      "required": [
        "name"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Represents an administrator user in the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The admin's full name."
        },
        "email": {
          "type": "string",
          "description": "The admin's email address.",
          "format": "email"
        },
        "password": {
          "type": "string",
          "description": "The admin's password."
        }
      },
      "required": [
        "name",
        "email"
      ]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Represents a teacher user in the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The teacher's full name."
        },
        "email": {
          "type": "string",
          "description": "The teacher's email address.",
          "format": "email"
        },
        "password": {
          "type": "string",
          "description": "The teacher's password."
        },
        "classIds": {
          "type": "array",
          "description": "References to Classes taught by the teacher.",
          "items": {
            "type": "string"
          }
        },
        "sectionIds": {
          "type": "array",
          "description": "References to Sections taught by the teacher.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "email"
      ]
    },
    "Timetable": {
      "title": "Timetable",
      "description": "Represents the weekly timetable for a specific class section.",
      "type": "object",
      "properties": {
        "9:00-10:00": { "type": "object", "properties": { "Monday": {"type": "string"}, "Tuesday": {"type": "string"}, "Wednesday": {"type": "string"}, "Thursday": {"type": "string"}, "Friday": {"type": "string"} } },
        "10:00-11:00": { "type": "object", "properties": { "Monday": {"type": "string"}, "Tuesday": {"type": "string"}, "Wednesday": {"type": "string"}, "Thursday": {"type": "string"}, "Friday": {"type": "string"} } },
        "11:00-12:00": { "type": "object", "properties": { "Monday": {"type": "string"}, "Tuesday": {"type": "string"}, "Wednesday": {"type": "string"}, "Thursday": {"type": "string"}, "Friday": {"type": "string"} } },
        "12:00-13:00": { "type": "object", "properties": { "Monday": {"type": "string"}, "Tuesday": {"type": "string"}, "Wednesday": {"type": "string"}, "Thursday": {"type": "string"}, "Friday": {"type": "string"} } },
        "13:00-14:00": { "type": "object", "properties": { "Monday": {"type": "string"}, "Tuesday": {"type": "string"}, "Wednesday": {"type": "string"}, "Thursday": {"type": "string"}, "Friday": {"type": "string"} } },
        "14:00-15:00": { "type": "object", "properties": { "Monday": {"type": "string"}, "Tuesday": {"type": "string"}, "Wednesday": {"type": "string"}, "Thursday": {"type": "string"}, "Friday": {"type": "string"} } },
        "15:00-16:00": { "type": "object", "properties": { "Monday": {"type": "string"}, "Tuesday": {"type": "string"}, "Wednesday": {"type": "string"}, "Thursday": {"type": "string"}, "Friday": {"type": "string"} } },
        "16:00-17:00": { "type": "object", "properties": { "Monday": {"type": "string"}, "Tuesday": {"type": "string"}, "Wednesday": {"type": "string"}, "Thursday": {"type": "string"}, "Friday": {"type": "string"} } }
      }
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Represents an assignment for a class section.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "classId": { "type": "string" },
        "sectionId": { "type": "string" },
        "createdAt": { "type": "object"}
      },
      "required": ["title", "subject", "dueDate", "classId", "sectionId", "createdAt"]
    },
    "StudentAssignment": {
      "title": "Student Assignment",
      "description": "Tracks a student's progress on an assignment.",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string" },
        "studentId": { "type": "string" },
        "status": { "type": "string", "enum": ["Not Started", "In Progress", "Completed"] },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"] }
      },
      "required": ["assignmentId", "studentId", "status", "priority"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Represents a message in a group chat.",
      "type": "object",
      "properties": {
        "authorName": { "type": "string" },
        "authorId": { "type": "string" },
        "authorAvatarId": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "object" }
      },
      "required": ["authorName", "authorId", "message", "timestamp"]
    },
    "Event": {
        "title": "Event",
        "description": "Represents a calendar event.",
        "type": "object",
        "properties": {
            "title": { "type": "string" },
            "date": { "type": "string", "format": "date" },
            "type": { "type": "string", "enum": ["meeting", "event", "academic", "holiday", "other"] },
            "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
            "createdAt": { "type": "object"}
        },
        "required": ["title", "date", "type", "priority", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "collections": {
      "classes": {
        "schema": {
          "$ref": "#/entities/Class"
        },
        "description": "Top-level collection for all classes in the school.",
        "collections": {
          "sections": {
            "schema": {
              "$ref": "#/entities/Section"
            },
            "description": "Sub-collection for sections within a class.",
            "collections": {
              "students": {
                "schema": {
                  "$ref": "#/entities/Student"
                },
                "description": "Sub-collection for students within a specific class and section."
              },
               "timetable": {
                "schema": {
                  "$ref": "#/entities/Timetable"
                },
                "description": "Sub-collection for the weekly timetable of a section."
              }
            }
          }
        }
      },
      "admins": {
        "schema": {
          "$ref": "#/entities/Admin"
        },
        "description": "Collection for administrator accounts."
      },
      "teachers": {
        "schema": {
          "$ref": "#/entities/Teacher"
        },
        "description": "Collection for teacher accounts."
      },
       "assignments": {
        "schema": {
          "$ref": "#/entities/Assignment"
        },
        "description": "All assignments for all classes."
      },
      "student-assignments": {
        "schema": {
          "$ref": "#/entities/StudentAssignment"
        },
        "description": "Tracks assignment status for each student."
      },
      "groups": {
          "schema": { "$ref": "#/entities/ChatMessage" },
          "description": "Collection for group chat messages. Sub-collections are group IDs (e.g., 'teachers', 'parents').",
          "collections": {
              "messages": {
                  "schema": { "$ref": "#/entities/ChatMessage" },
                  "description": "Messages within a specific group chat."
              }
          }
      },
      "events": {
        "schema": {
            "$ref": "#/entities/Event"
        },
        "description": "All calendar events for the school."
      }
    },
