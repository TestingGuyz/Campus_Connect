rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
    /*
    // --- Helper Functions ---
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isTeacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }

    function isStudent() {
      return signedIn() && request.auth.token.role == 'student';
    }

    // --- Admin Messages Collection ---
    // Students send messages, admins reply
    match /admin-messages/{messageId} {
      // Students can read their own messages
      // Admins can read all messages
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );
      
      // Students can create messages (must set their own studentId)
      allow create: if signedIn() && 
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.isReply == false;
      
      // Admins can create reply messages
      allow create: if isAdmin() && 
        request.resource.data.isReply == true;
      
      // Admins can update messages (to mark as read, add replies, etc.)
      allow update: if isAdmin();
      
      // Admins can delete messages
      allow delete: if isAdmin();
    }

    // --- Admins Collection ---
    match /admins/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    // --- Teachers Collection ---
    match /teachers/{teacherId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == teacherId);
      allow write: if isAdmin();
    }
    
    // --- Classes Collection ---
    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      // Sections subcollection
      match /sections/{sectionId} {
        allow read: if signedIn();
        allow write: if isAdmin() || isTeacher();

        // Students in sections
        match /students/{studentId} {
          allow read: if isAdmin() || isTeacher();
          allow write: if isAdmin();
        }
        
        // Timetables
        match /timetable/{docId} {
          allow read: if signedIn();
          allow write: if isAdmin() || isTeacher();
        }
      }
    }
    
    // --- Assignments Collection ---
    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isTeacher();
    }

    // --- Student Assignments Collection ---
    match /student-assignments/{docId} {
      allow read, write: if signedIn() && (
        (request.resource != null && request.auth.uid == request.resource.data.studentId) ||
        (resource != null && request.auth.uid == resource.data.studentId)
      );
    }
    
    // --- Chat Groups ---
    match /groups/{groupId}/messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if false;
    }

    // --- Calendar Events ---
    match /events/{eventId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    */
  }
}
