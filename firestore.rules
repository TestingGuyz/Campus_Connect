rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admins have a document in the /admins collection with their UID.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Teachers have a document in the /teachers collection with their UID.
    function isTeacher() {
      return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    
    // A teacher assigned to the specific class and section.
    function isTeacherForClass(classId) {
      return isTeacher() && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.classIds.hasAny([classId]);
    }
    
    function isTeacherForSection(sectionId) {
        return isTeacher() && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.sectionIds.hasAny([sectionId]);
    }

    // Unauthenticated users can query for users to verify credentials before login.
    match /{path=**}/students/{studentId} {
        allow read: if true;
        allow write: if isAdmin() || isTeacherForClass(path[1]) && isTeacherForSection(path[3]);
    }
    
    match /classes/{classId} {
      allow read: if true; // All users can read class info
      allow write: if isAdmin();
      
      match /sections/{sectionId} {
        allow read: if true; // All users can read section info
        allow write: if isAdmin();

        // Students can be read by admins or teachers of that class.
        // Students can only be written by admins or assigned teachers.
        match /students/{studentId} {
            allow read: if isAdmin() || isTeacherForClass(classId);
            allow write: if isAdmin() || isTeacherForClass(classId) && isTeacherForSection(sectionId);
        }
      }
    }

    // Admins can manage other admins and teachers.
    match /admins/{userId} {
      allow read, write: if isAdmin();
    }
    
    match /teachers/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin();
    }
  }
}
