rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // --- Auth helper functions ---
    function signedIn() {
      return request.auth != null;
    }
    
    // Custom claims checkers. These are much more perform-ant and secure.
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isTeacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }

    function isStudent() {
      return signedIn() && request.auth.token.role == 'student';
    }


    // --- Collection-specific Rules ---

    // Admins have God-mode. This simplifies all other rules.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /admins/{userId} {
      // Only other admins can read/write the admins list.
      // This is now covered by the God-mode rule, but kept for clarity.
      allow read, write: if isAdmin();
    }

    match /teachers/{teacherId} {
      // Teachers can read their own profile.
      allow read: if isTeacher() && request.auth.uid == teacherId;
      // Admins can manage teachers (covered by God-mode rule).
    }
    
    match /classes/{classId} {
      allow read: if signedIn();
      // Admins can write (covered by God-mode rule).

      match /sections/{sectionId} {
        allow read: if signedIn();
        allow write: if isTeacher(); // Teachers can manage sections.

        match /students/{studentId} {
          allow read: if isTeacher();
          allow write: if isAdmin() || isTeacher();
        }
        
        match /timetable/{docId} {
            allow read: if signedIn();
            allow write: if isTeacher();
        }
      }
    }
    
    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    match /student-assignments/{docId} {
      // A student can only read/write their own assignment status.
      allow read, write: if isStudent() && (
        (request.resource != null && request.auth.uid == request.resource.data.studentId) || 
        (resource != null && request.auth.uid == resource.data.studentId) 
      );
      // A teacher can also read student assignment status
      allow read: if isTeacher();
    }
    
    match /groups/{groupId}/messages/{messageId} {
      allow read: if signedIn();
      // Users can only create messages as themselves
      allow create: if signedIn() && request.auth.uid == request.resource.data.authorId;
      // No one can update or delete messages
      allow update, delete: if false;
    }
    
     match /admin-messages/{messageId} {
        // Students can read their own messages and write new ones.
        allow read, create: if isStudent() && request.resource.data.studentId == request.auth.uid;
        // Admins can read all messages and write replies.
        allow read, write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      // Admins can create/update/delete events (covered by God-mode rule).
    }
  }
}
