rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Auth helper functions ---
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Check if the user is in the /admins collection
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTeacher() {
      // Check if the user is in the /teachers collection
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // A user is a student if they are signed in and not an admin or teacher.
    // This is a simplification. For more complex scenarios, you might have a dedicated 'students' collection for auth records.
    function isStudent() {
      return signedIn() && !isAdmin() && !isTeacher();
    }


    // --- Collection-specific Rules ---

    match /admins/{userId} {
      // Only other admins can read/write the admins list.
      allow read, write: if isAdmin();
    }

    match /teachers/{teacherId} {
      // Admins can manage teachers. Teachers can read their own profile.
      allow read: if isAdmin() || (signedIn() && request.auth.uid == teacherId);
      allow write: if isAdmin();
    }
    
    // Classes can be read by any authenticated user, but only managed by admins.
    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      // Sections can be read by any authenticated user.
      // Sections can be managed by admins or teachers.
      match /sections/{sectionId} {
        allow read: if signedIn();
        allow write: if isAdmin() || isTeacher();

        // Students can be read by admins and teachers.
        // Student documents are managed by admins.
        match /students/{studentId} {
          allow read: if isAdmin() || isTeacher();
          allow write: if isAdmin();
        }
        
        // Timetables can be read by any signed-in user.
        match /timetable/{docId} {
            allow read: if signedIn();
            allow write: if isAdmin() || isTeacher();
        }
      }
    }
    
    // Assignments can be read by anyone signed in.
    // Assignments can only be created/updated/deleted by admins or teachers.
    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isTeacher();
    }

    // Student-specific assignment tracking data.
    // Only the student themselves can create or update their own assignment status.
    match /student-assignments/{docId} {
      allow read, write: if signedIn() && (
        (request.resource != null && request.auth.uid == request.resource.data.studentId) || // On create
        (resource != null && request.auth.uid == resource.data.studentId) // on update/delete
      );
    }
    
    // Chat groups
    match /groups/{groupId}/messages/{messageId} {
      // Anyone signed in can read messages in any group
      allow read: if signedIn();
      // Users can only create messages as themselves
      allow create: if signedIn() && request.auth.uid == request.resource.data.authorId;
      // No one can update or delete messages
      allow update, delete: if false;
    }

    // Calendar events
    match /events/{eventId} {
      // Anyone can read events
      allow read: if signedIn();
      // Only admins can create, update, or delete events.
      allow write: if isAdmin();
    }
  }
}
